            "title": "Zodiac",
            "type": "string"
          }
        },
        "title": "CalculationMetadata",
        "type": "object"
      },
      "Planet": {
        "additionalProperties": false,
        "properties": {
          "body": {
            "enum": [
              "sun",
              "moon",
              "mercury",
              "venus",
              "mars",
              "jupiter",
              "saturn",
              "uranus",
              "neptune",
              "pluto"
