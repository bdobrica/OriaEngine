{
  "request": {
    "$defs": {
      "NatalPosition": {
        "additionalProperties": false,
        "properties": {
          "body": {
            "enum": [
              "sun",
              "moon",
              "mercury",
              "venus",
              "mars",
              "jupiter",
              "saturn",
              "uranus",
              "neptune",
              "pluto"
            ],
            "title": "Body",
            "type": "string"
          },
          "longitude": {
            "exclusiveMaximum": 360,
            "minimum": 0,
            "title": "Longitude",
            "type": "number"
          }
        },
        "required": [
          "body",
          "longitude"
        ],
        "title": "NatalPosition",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "birth_time_accuracy": {
        "enum": [
          "exact",
          "approximate",
          "unknown"
        ],
        "title": "Birth Time Accuracy",
        "type": "string"
      },
      "contract_version": {
        "const": 1,
        "default": 1,
        "title": "Contract Version",
        "type": "integer"
      },
      "natal_positions": {
        "items": {
          "$ref": "#/$defs/NatalPosition"
        },
        "title": "Natal Positions",
        "type": "array"
      },
      "target_timestamp_utc": {
        "format": "date-time",
        "title": "Target Timestamp Utc",
        "type": "string"
      }
    },
    "required": [
      "target_timestamp_utc",
      "birth_time_accuracy",
      "natal_positions"
    ],
    "title": "TransitRequest",
    "type": "object"
  },
