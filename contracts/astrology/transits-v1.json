            "title": "Name",
            "type": "string"
          },
          "orb": {
            "maximum": 6,
            "minimum": 0,
            "title": "Orb",
            "type": "number"
          },
          "relative_velocity_deg_day": {
            "title": "Relative Velocity Deg Day",
            "type": "number"
          },
          "target_angle": {
            "enum": [
              0,
              60,
              90,
              120,
              180
