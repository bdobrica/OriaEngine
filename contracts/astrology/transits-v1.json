            "type": "number"
          },
          "applying": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Applying"
          },
          "body_a": {
            "enum": [
              "sun",
              "moon",
              "mercury",
              "venus",
              "mars",
              "jupiter",
              "saturn",
              "uranus",
              "neptune",
              "pluto"
            ],
            "title": "Body A",
            "type": "string"
          },
          "body_b": {
            "enum": [
              "sun",
              "moon",
              "mercury",
              "venus",
              "mars",
              "jupiter",
              "saturn",
              "uranus",
              "neptune",
              "pluto"
            ],
            "title": "Body B",
            "type": "string"
          },
          "name": {
            "enum": [
              "conjunction",
              "sextile",
              "square",
              "trine",
              "opposition"
