      },
      "birth_time_accuracy": {
        "enum": [
          "exact",
          "approximate",
          "unknown"
        ],
        "title": "Birth Time Accuracy",
        "type": "string"
      },
      "contract_version": {
        "const": 1,
        "default": 1,
        "title": "Contract Version",
        "type": "integer"
      },
      "metadata": {
        "$ref": "#/$defs/TransitMetadata"
      },
      "planets": {
        "items": {
          "$ref": "#/$defs/Planet"
        },
        "title": "Planets",
        "type": "array"
      },
      "target_timestamp_utc": {
        "format": "date-time",
        "title": "Target Timestamp Utc",
        "type": "string"
      }
