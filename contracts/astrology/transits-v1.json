      "TransitMetadata": {
        "additionalProperties": false,
        "properties": {
          "aspect_reference": {
            "const": "body_a_fixed_natal_body_b_transiting",
            "default": "body_a_fixed_natal_body_b_transiting",
            "title": "Aspect Reference",
            "type": "string"
          },
          "astronomy": {
            "$ref": "#/$defs/CalculationMetadata",
            "default": {
              "aspect_orb_degrees": 6,
              "binding_version": "2.10.3.2",
              "engine_version": "oria-natal-1",
              "ephemeris": "moshier",
              "ephemeris_data_version": "bundled-with-swisseph-2.10.03",
              "house_system": "P",
              "reference_frame": "apparent-geocentric-ecliptic-of-date",
              "swiss_ephemeris_version": "2.10.03",
              "zodiac": "tropical"
            }
          },
          "engine_version": {
            "const": "oria-transits-1",
            "default": "oria-transits-1",
            "title": "Engine Version",
            "type": "string"
          },
          "time_to_exact_method": {
            "const": "unavailable",
            "default": "unavailable",
            "title": "Time To Exact Method",
            "type": "string"
          }
