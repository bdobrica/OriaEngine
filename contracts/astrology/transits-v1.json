          },
          "retrograde": {
            "title": "Retrograde",
            "type": "boolean"
          },
          "sign": {
            "enum": [
              "Aries",
              "Taurus",
              "Gemini",
              "Cancer",
              "Leo",
              "Virgo",
              "Libra",
              "Scorpio",
              "Sagittarius",
              "Capricorn",
              "Aquarius",
              "Pisces"
            ],
            "title": "Sign",
            "type": "string"
          }
        },
        "required": [
          "body",
          "longitude",
          "sign",
          "degree_in_sign",
          "longitude_velocity_deg_day",
          "retrograde"
        ],
        "title": "Planet",
        "type": "object"
      },
      "TransitAvailability": {
        "additionalProperties": false,
        "properties": {
          "angles": {
            "const": false,
            "default": false,
