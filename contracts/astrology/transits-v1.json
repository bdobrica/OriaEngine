            "type": "boolean"
          },
          "houses": {
            "const": false,
            "default": false,
            "title": "Houses",
            "type": "boolean"
          },
          "natal_aspects": {
            "title": "Natal Aspects",
            "type": "boolean"
          },
          "positions": {
            "const": true,
            "default": true,
