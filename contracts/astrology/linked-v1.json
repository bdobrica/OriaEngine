        "additionalProperties": false,
        "properties": {
          "angles": {
            "anyOf": [
              {
                "$ref": "#/$defs/Angles"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "house_cusps": {
            "default": [],
            "items": {
              "exclusiveMaximum": 360,
              "minimum": 0,
              "type": "number"
            },
            "title": "House Cusps",
            "type": "array"
          },
          "planets": {
            "items": {
              "$ref": "#/$defs/Planet"
            },
            "maxItems": 10,
            "minItems": 10,
            "title": "Planets",
            "type": "array"
          },
          "precision": {
            "enum": [
              "exact",
              "approximate",
              "date_sample"
            ],
            "title": "Precision",
            "type": "string"
          },
          "reasons": {
            "default": [],
            "items": {
              "enum": [
                "date_only_sample",
                "approximate_date",
                "approximate_time",
                "place_unknown",
                "houses_unsupported"
              ],
              "type": "string"
            },
            "title": "Reasons",
            "type": "array"
          }
        },
        "required": [
          "precision",
          "planets"
        ],
        "title": "ChartFacts",
        "type": "object"
      },
      "LinkedMetadata": {
        "additionalProperties": false,
        "properties": {
          "astronomy": {
            "$ref": "#/$defs/CalculationMetadata"
          },
          "comparison": {
            "const": "static-longitude-major-6deg-1",
            "default": "static-longitude-major-6deg-1",
            "title": "Comparison",
            "type": "string"
          },
          "date_sampling": {
            "const": "calendar-date-at-12-utc-1",
            "default": "calendar-date-at-12-utc-1",
            "title": "Date Sampling",
            "type": "string"
          },
          "engine_version": {
            "const": "oria-linked-1",
            "default": "oria-linked-1",
            "title": "Engine Version",
            "type": "string"
          }
        },
        "title": "LinkedMetadata",
        "type": "object"
      },
      "Planet": {
        "additionalProperties": false,
        "properties": {
          "body": {
            "enum": [
              "sun",
              "moon",
              "mercury",
              "venus",
              "mars",
              "jupiter",
              "saturn",
              "uranus",
              "neptune",
              "pluto"
            ],
            "title": "Body",
            "type": "string"
          },
          "degree_in_sign": {
            "exclusiveMaximum": 30,
            "minimum": 0,
            "title": "Degree In Sign",
            "type": "number"
          },
          "house": {
            "anyOf": [
              {
                "maximum": 12,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "House"
          },
          "longitude": {
            "exclusiveMaximum": 360,
            "minimum": 0,
            "title": "Longitude",
            "type": "number"
          },
          "longitude_velocity_deg_day": {
            "title": "Longitude Velocity Deg Day",
            "type": "number"
          },
          "retrograde": {
            "title": "Retrograde",
            "type": "boolean"
          },
          "sign": {
            "enum": [
              "Aries",
              "Taurus",
              "Gemini",
              "Cancer",
              "Leo",
              "Virgo",
              "Libra",
              "Scorpio",
              "Sagittarius",
              "Capricorn",
              "Aquarius",
              "Pisces"
            ],
            "title": "Sign",
            "type": "string"
          }
        },
        "required": [
          "body",
          "longitude",
          "sign",
          "degree_in_sign",
          "longitude_velocity_deg_day",
          "retrograde"
        ],
        "title": "Planet",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "calculation_id": {
        "format": "uuid",
        "title": "Calculation Id",
        "type": "string"
      },
      "chart": {
        "$ref": "#/$defs/ChartFacts"
      },
      "contract_version": {
        "const": 1,
        "default": 1,
        "title": "Contract Version",
        "type": "integer"
      },
      "metadata": {
        "$ref": "#/$defs/LinkedMetadata"
      }
    },
    "required": [
      "calculation_id",
      "chart"
    ],
    "title": "ChartResult",
    "type": "object"
  },
