{
  "chart_request": {
    "$defs": {
      "ChartInput": {
        "additionalProperties": false,
        "properties": {
          "accuracy": {
            "enum": [
              "exact",
              "approximate",
              "unknown"
            ],
            "title": "Accuracy",
            "type": "string"
          },
          "calendar_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Calendar Date"
          },
          "date_approximate": {
            "default": false,
            "title": "Date Approximate",
            "type": "boolean"
          },
          "latitude": {
            "anyOf": [
              {
                "maximum": 90,
                "minimum": -90,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Latitude"
          },
          "longitude": {
            "anyOf": [
              {
                "maximum": 180,
                "minimum": -180,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Longitude"
          },
          "timestamp_utc": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Timestamp Utc"
          }
        },
        "required": [
          "accuracy"
        ],
        "title": "ChartInput",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "calculation_id": {
        "format": "uuid",
        "title": "Calculation Id",
        "type": "string"
      },
      "chart": {
        "$ref": "#/$defs/ChartInput"
      },
      "contract_version": {
        "const": 1,
        "default": 1,
        "title": "Contract Version",
        "type": "integer"
      }
    },
    "required": [
      "calculation_id",
      "chart"
    ],
    "title": "ChartRequest",
    "type": "object"
  },
  "chart_response": {
    "$defs": {
      "Angles": {
        "additionalProperties": false,
        "properties": {
          "ascendant": {
            "exclusiveMaximum": 360,
            "minimum": 0,
            "title": "Ascendant",
            "type": "number"
          },
          "midheaven": {
            "exclusiveMaximum": 360,
            "minimum": 0,
            "title": "Midheaven",
            "type": "number"
          }
        },
        "required": [
          "ascendant",
          "midheaven"
        ],
        "title": "Angles",
        "type": "object"
      },
      "CalculationMetadata": {
        "additionalProperties": false,
        "properties": {
          "aspect_orb_degrees": {
            "const": 6,
            "default": 6,
            "title": "Aspect Orb Degrees",
            "type": "integer"
          },
          "binding_version": {
            "const": "2.10.3.2",
            "default": "2.10.3.2",
            "title": "Binding Version",
            "type": "string"
          },
          "engine_version": {
            "const": "oria-natal-1",
            "default": "oria-natal-1",
            "title": "Engine Version",
            "type": "string"
          },
          "ephemeris": {
            "const": "moshier",
            "default": "moshier",
            "title": "Ephemeris",
            "type": "string"
          },
          "ephemeris_data_version": {
            "const": "bundled-with-swisseph-2.10.03",
            "default": "bundled-with-swisseph-2.10.03",
            "title": "Ephemeris Data Version",
            "type": "string"
          },
          "house_system": {
            "const": "P",
            "default": "P",
            "title": "House System",
            "type": "string"
          },
          "reference_frame": {
            "const": "apparent-geocentric-ecliptic-of-date",
            "default": "apparent-geocentric-ecliptic-of-date",
            "title": "Reference Frame",
            "type": "string"
          },
          "swiss_ephemeris_version": {
            "const": "2.10.03",
            "default": "2.10.03",
            "title": "Swiss Ephemeris Version",
            "type": "string"
          },
          "zodiac": {
            "const": "tropical",
            "default": "tropical",
            "title": "Zodiac",
            "type": "string"
          }
        },
        "title": "CalculationMetadata",
        "type": "object"
      },
