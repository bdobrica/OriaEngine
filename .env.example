# Application
APP_ENV=development
LOG_LEVEL=INFO

# Canonical storage and disposable coordination
# Local Compose only: replace this placeholder and match the DATABASE_URL password.
POSTGRES_PASSWORD=oria
POSTGRES_PORT=5432
REDIS_PORT=6379
# Complete Docker stack: internal DB/Redis/MCP URLs are supplied by Compose.
GATEWAY_PORT=8001
# If the password contains URL delimiters, set its percent-encoded form here.
# POSTGRES_PASSWORD_URLENCODED=
DATABASE_URL=postgresql+psycopg://oria:oria@localhost:5432/oria
REDIS_URL=redis://localhost:6379/0

# Admission controls shared by polling and webhook gateways.
INBOUND_RATE_PER_MINUTE=20
QUEUED_JOBS_PER_USER=8
# Emergency stop for conversation generation; restart all workers after changing.
# Deterministic commands and account deletion remain available.
LLM_PROCESSING_ENABLED=true

# Telegram (leave blank until local bot setup)
TELEGRAM_BOT_TOKEN=
# Public HTTPS origin/optional prefix; registration appends /telegram/webhook.
TELEGRAM_WEBHOOK_BASE_URL=
# Nonempty enables HTTP ingress; generate privately and share with setWebhook.
TELEGRAM_WEBHOOK_SECRET=

# Base64 encoding of 32 random bytes (AES-256); never commit a real key.
# Required for profile storage and production; may be empty for the local HTTP skeleton.
# Keep the same key across restarts. See docs/birth-profiles.md before changing keys.
PROFILE_ENCRYPTION_KEY=
PROFILE_ENCRYPTION_KEY_VERSION=v1

# External services
SECOND_CONTEXT_BASE_URL=http://localhost:8080
# Container-accessible URL used by make dev. A host service must accept bridge traffic.
SECOND_CONTEXT_DOCKER_URL=http://host.docker.internal:8080
# Set to oria with a namespace service token; empty preserves legacy UUID scopes.
SECOND_CONTEXT_SUBJECT_NAMESPACE=
SECOND_CONTEXT_BEARER_TOKEN=
ASTROLOGY_MCP_URL=http://localhost:8000/mcp

# Versioned product policy
ORIA_POLICY_VERSION=2026-10-03.2
