# Copy privately with make deploy-env; never commit deploy/.env.
# Select tags that have actually been published, or immutable @sha256 digests.
# Example: quay.io/bdobrica/oria-engine:0.1.1 (only after its release succeeds).
ORIA_APP_IMAGE=
# Example: quay.io/bdobrica/oria-astrology-mcp:0.1.1
ORIA_ASTROLOGY_IMAGE=

# Generate a strong password; hexadecimal avoids URL-encoding ambiguity.
POSTGRES_PASSWORD=
# If using URL delimiters, also provide the percent-encoded password here.
POSTGRES_PASSWORD_URLENCODED=
# Loopback only; provide HTTPS through your existing reverse proxy/tunnel.
GATEWAY_PORT=8001
LOG_LEVEL=INFO

TELEGRAM_BOT_TOKEN=
# Public HTTPS origin/optional prefix, without /telegram/webhook.
TELEGRAM_WEBHOOK_BASE_URL=
TELEGRAM_WEBHOOK_SECRET=
# Base64-encoded 32 random bytes; retain securely across restarts and upgrades.
PROFILE_ENCRYPTION_KEY=
PROFILE_ENCRYPTION_KEY_VERSION=v1
ORIA_POLICY_VERSION=2026-10-03.2

# Private container-reachable API URL, e.g. http://second-context.example.internal:8080.
# localhost would refer to the Oria container itself.
SECOND_CONTEXT_BASE_URL=
# SecondContext must use AUTH_ENABLED=true and AUTH_SERVICE_TOKENS=oria:=<same token>.
# The stack fixes SECOND_CONTEXT_SUBJECT_NAMESPACE=oria; keep it stable.
SECOND_CONTEXT_BEARER_TOKEN=

INBOUND_RATE_PER_MINUTE=20
QUEUED_JOBS_PER_USER=8
LLM_PROCESSING_ENABLED=true
