# Copy privately with make deploy-env; never commit deploy/.env.
# Select tags that have actually been published, or immutable @sha256 digests.
# Example: quay.io/bdobrica/oria-engine:0.1.1 (only after its release succeeds).
ORIA_APP_IMAGE=
# Example: quay.io/bdobrica/oria-astrology-mcp:0.1.1
ORIA_ASTROLOGY_IMAGE=

# Generate a strong password; hexadecimal avoids URL-encoding ambiguity.
POSTGRES_PASSWORD=
# If using URL delimiters, also provide the percent-encoded password here.
POSTGRES_PASSWORD_URLENCODED=
# Full stack only: bootstrap administrator; never passed to application containers.
POSTGRES_ADMIN_PASSWORD=
# Loopback only; provide HTTPS through your existing reverse proxy/tunnel.
GATEWAY_PORT=8001
LOG_LEVEL=INFO

TELEGRAM_BOT_TOKEN=
# Public HTTPS origin/optional prefix, without /telegram/webhook.
TELEGRAM_WEBHOOK_BASE_URL=
TELEGRAM_WEBHOOK_SECRET=
# Base64-encoded 32 random bytes; retain securely across restarts and upgrades.
PROFILE_ENCRYPTION_KEY=
PROFILE_ENCRYPTION_KEY_VERSION=v1
ORIA_POLICY_VERSION=2026-11-10.1

# Shared service token; bundled SecondContext configures AUTH_SERVICE_TOKENS=oria:=<same token>.
# The stack fixes SECOND_CONTEXT_SUBJECT_NAMESPACE=oria; keep it stable.
SECOND_CONTEXT_BEARER_TOKEN=
# Gateway release containing /app/migrate and SQL (0.1.1 or compatible later release).
# Example: quay.io/bdobrica/secondcontext-gateway:0.1.1, after publication succeeds.
SECOND_CONTEXT_IMAGE=
SECOND_CONTEXT_POSTGRES_PASSWORD=
# Passed only to the SecondContext API, never Oria/MCP/migration containers.
SECOND_CONTEXT_OPENAI_API_KEY=
SECOND_CONTEXT_OPENAI_BASE_URL=https://api.openai.com/v1
SECOND_CONTEXT_CHAT_MODEL=gpt-4.1-mini
SECOND_CONTEXT_EMBEDDING_MODEL=text-embedding-3-small
# Must match the embedding model's output; keep stable for an existing collection.
SECOND_CONTEXT_VECTOR_SIZE=1536
# Standalone compose.oria.yaml only (separately managed provider).
# Set a private container-reachable URL; localhost means the Oria container itself.
SECOND_CONTEXT_BASE_URL=http://secondcontext:8080

INBOUND_RATE_PER_MINUTE=20
QUEUED_JOBS_PER_USER=8
LLM_PROCESSING_ENABLED=true

# Enable only after the linked-context-1 SecondContext release and migration 000004.
SECOND_CONTEXT_KNOWLEDGE_ENABLED=false
# Managed recent history requires linked memory and the new disclosure; default off.
SECOND_CONTEXT_HISTORY_ENABLED=false
# Bundled provider only; enable and verify before enabling Oria capture above.
# Keep these model budgets within the configured model's supported limits.
SECOND_CONTEXT_PROVIDER_HISTORY_ENABLED=false
SECOND_CONTEXT_HISTORY_RECENT_EXCHANGES=8
SECOND_CONTEXT_HISTORY_PROMPT_INPUT_TOKENS=65536
SECOND_CONTEXT_HISTORY_RESERVED_OUTPUT_TOKENS=4096

# Optional CH4/CH5 observation, passed only to SecondContext.
# Requires a compatible published provider and a successful synthetic access check.
# Keep off until the release gates pass; adaptive routing remains unavailable.
# Use a separate random cache secret of at least 32 bytes.
# Provider capability only; does not switch Oria away from recent.
SECOND_CONTEXT_HISTORY_ADAPTIVE_ENABLED=false
SECOND_CONTEXT_DECISIONS_OBSERVE_ENABLED=false
SECOND_CONTEXT_DECISIONS_BASE_URL=https://api.openai.com/v1
SECOND_CONTEXT_DECISIONS_API_KEY=
SECOND_CONTEXT_DECISIONS_MODEL=gpt-6-luna
SECOND_CONTEXT_DECISIONS_RECIPE=history-dependence-1
SECOND_CONTEXT_DECISIONS_CACHE_SECRET=
SECOND_CONTEXT_DECISIONS_TIMEOUT=2s
SECOND_CONTEXT_DECISIONS_MAX_INPUT_BYTES=65536
SECOND_CONTEXT_DECISIONS_SEGMENT_EXCHANGES=32
SECOND_CONTEXT_DECISIONS_INPUT_USD_PER_MILLION=
SECOND_CONTEXT_DECISIONS_CACHED_USD_PER_MILLION=
SECOND_CONTEXT_DECISIONS_WRITE_USD_PER_MILLION=
SECOND_CONTEXT_HISTORY_GENERATION_INPUT_USD_PER_MILLION=
SECOND_CONTEXT_HISTORY_GENERATION_CACHED_USD_PER_MILLION=
SECOND_CONTEXT_HISTORY_GENERATION_OUTPUT_USD_PER_MILLION=
