# Replace the hostname and certificate paths; validate with nginx -t before use.
# Keep the supported gateway on loopback (make api) and dependencies private.
server {
    listen 443 ssl;
    server_name bot.example.com;
    ssl_certificate /etc/letsencrypt/live/bot.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bot.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Requests can contain private text, query strings and credentials.
    access_log off;
    error_log /dev/null;
    client_max_body_size 256k;
    client_body_timeout 10s;

    location = /telegram/webhook {
        proxy_pass http://127.0.0.1:8001/telegram/webhook;
        proxy_set_header Host $host;
        # Forward the incoming value; never inject your configured secret here.
        proxy_set_header X-Telegram-Bot-Api-Secret-Token $http_x_telegram_bot_api_secret_token;
        proxy_connect_timeout 2s;
        proxy_send_timeout 10s;
        proxy_read_timeout 10s;
        proxy_intercept_errors off;
        proxy_cache off;
    }

    location / {
        return 404;
    }
}
